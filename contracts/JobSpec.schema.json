{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "extract",
        "technical_review",
        "business_review",
        "security_review",
        "evaluation_draft"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "max_cost_eur": {
      "type": "number",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "blocked"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "job_id",
    "job_type",
    "input_refs",
    "policy_version",
    "max_cost_eur",
    "state",
    "attempt",
    "idempotency_key"
  ]
}
