{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamRoster",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "team_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "challenge_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roster_version": {
      "type": "string",
      "minLength": 1
    },
    "verified_by_role": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "team_id",
    "challenge_id",
    "members",
    "roster_version"
  ]
}
