{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engagement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
    },
    "scope_version": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sow_approved": {
      "type": "boolean"
    },
    "dpa_status": {
      "type": "string",
      "enum": [
        "approved",
        "not_applicable_with_reason",
        "pending"
      ]
    },
    "dpa_rationale": {
      "type": "string",
      "minLength": 1
    },
    "processing_purpose": {
      "type": "string",
      "minLength": 1
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "ip_terms_ref": {
      "type": "string",
      "minLength": 3
    },
    "prize_terms_ref": {
      "type": "string",
      "minLength": 3
    },
    "liability_terms_ref": {
      "type": "string",
      "minLength": 3
    }
  },
  "required": [
    "engagement_id",
    "client_id",
    "scope_version",
    "services",
    "sow_approved",
    "dpa_status",
    "dpa_rationale",
    "processing_purpose",
    "retention_days",
    "ip_terms_ref",
    "prize_terms_ref",
    "liability_terms_ref"
  ],
  "title": "EngagementConfig"
}
