{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTrace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "cost_eur": {
      "type": "number",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "trace_id",
    "job_id",
    "step",
    "input_refs",
    "output_refs",
    "outcome",
    "cost_eur",
    "limitations",
    "occurred_at"
  ]
}
