{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceClaim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "predicate": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "test",
        "static_review",
        "human_observation",
        "self_report",
        "source_document"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "rejected"
      ]
    },
    "reviewer_ref": {
      "type": "string",
      "minLength": 3
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "claim_id",
    "subject_id",
    "predicate",
    "value",
    "source_artifact_id",
    "source_locator",
    "method",
    "confidence",
    "observed_at",
    "review_state"
  ]
}
