{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
    },
    "sector": {
      "type": "string",
      "minLength": 1
    },
    "employee_count_band": {
      "type": "string",
      "enum": [
        "1-99",
        "100-499",
        "500-1999",
        "2000+"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "primary_goal": {
      "type": "string",
      "minLength": 1
    },
    "buyer_role": {
      "type": "string",
      "minLength": 1
    },
    "decision_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "sector",
    "primary_goal",
    "buyer_role"
  ],
  "title": "ClientBrief"
}
