{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityEvidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "capability_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "participant_alias": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "skill_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evidence_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "confidence_band": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_review_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "disputed",
        "rejected"
      ]
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "participant",
        "authorized_development_reviewer"
      ]
    },
    "challenge_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "capability_id",
    "participant_alias",
    "skill_id",
    "evidence_claim_ids",
    "context",
    "confidence_band",
    "limitations",
    "human_review_state",
    "visibility_scope",
    "challenge_id"
  ]
}
