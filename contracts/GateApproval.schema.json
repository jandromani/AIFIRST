{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate_id": {
      "type": "string",
      "enum": [
        "G0",
        "G1",
        "G2"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_reference": {
      "type": "string",
      "minLength": 3
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "gate_id",
    "decision",
    "reviewer_role",
    "reviewer_reference",
    "decision_at",
    "evidence_refs",
    "conditions"
  ],
  "title": "GateApproval"
}
