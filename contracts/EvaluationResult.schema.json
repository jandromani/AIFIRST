{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "submission_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "challenge_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "criterion_scores": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "veto_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "needs_evidence",
        "pending_jury",
        "jury_approved",
        "rejected"
      ]
    },
    "weighted_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "jury_review_ref": {
      "type": "string",
      "minLength": 3
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "evaluation_id",
    "submission_id",
    "challenge_id",
    "rubric_id",
    "rubric_version",
    "difficulty",
    "criterion_scores",
    "evidence_claim_ids",
    "veto_flags",
    "limitations",
    "review_state"
  ]
}
