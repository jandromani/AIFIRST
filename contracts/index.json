{
  "version": "1.0.0",
  "contracts": {
    "ClientBrief": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "sector": {
          "type": "string",
          "minLength": 1
        },
        "employee_count_band": {
          "type": "string",
          "enum": [
            "1-99",
            "100-499",
            "500-1999",
            "2000+"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "primary_goal": {
          "type": "string",
          "minLength": 1
        },
        "buyer_role": {
          "type": "string",
          "minLength": 1
        },
        "decision_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope_notes": {
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "sector",
        "primary_goal",
        "buyer_role"
      ],
      "title": "ClientBrief"
    },
    "SalesQualification": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "icp_fit": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "buyer_identified": {
          "type": "boolean"
        },
        "problem_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget_band": {
          "type": "string",
          "minLength": 1
        },
        "discovery_status": {
          "type": "string",
          "enum": [
            "qualified",
            "not_qualified",
            "pending"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "client_id",
        "icp_fit",
        "buyer_identified",
        "discovery_status",
        "next_action"
      ],
      "title": "SalesQualification"
    },
    "PricingQuote": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "currency": {
          "const": "EUR"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "number",
                "minimum": 0
              },
              "unit_cost_eur": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "label",
              "quantity",
              "unit_cost_eur"
            ]
          }
        },
        "target_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.85
        },
        "prizes_included": {
          "type": "boolean"
        },
        "commercial_price_eur": {
          "type": "number",
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "quote_id",
        "client_id",
        "currency",
        "items",
        "target_margin",
        "prizes_included",
        "commercial_price_eur",
        "assumptions"
      ],
      "title": "PricingQuote"
    },
    "EngagementConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engagement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "scope_version": {
          "type": "string",
          "minLength": 1
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sow_approved": {
          "type": "boolean"
        },
        "dpa_status": {
          "type": "string",
          "enum": [
            "approved",
            "not_applicable_with_reason",
            "pending"
          ]
        },
        "dpa_rationale": {
          "type": "string",
          "minLength": 1
        },
        "processing_purpose": {
          "type": "string",
          "minLength": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "ip_terms_ref": {
          "type": "string",
          "minLength": 3
        },
        "prize_terms_ref": {
          "type": "string",
          "minLength": 3
        },
        "liability_terms_ref": {
          "type": "string",
          "minLength": 3
        }
      },
      "required": [
        "engagement_id",
        "client_id",
        "scope_version",
        "services",
        "sow_approved",
        "dpa_status",
        "dpa_rationale",
        "processing_purpose",
        "retention_days",
        "ip_terms_ref",
        "prize_terms_ref",
        "liability_terms_ref"
      ],
      "title": "EngagementConfig"
    },
    "CompanyContext": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "business_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "sponsor_role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "statement",
              "sponsor_role"
            ]
          }
        },
        "org_units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "owner_role": {
                "type": "string",
                "minLength": 1
              },
              "volume_estimate": {
                "type": "number",
                "minimum": 0
              },
              "baseline_ref": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "id",
              "name",
              "owner_role",
              "baseline_ref"
            ]
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "technology": {
          "type": "string",
          "minLength": 1
        },
        "approved_ai_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "restrictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage_notes": {
          "type": "string",
          "minLength": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "client_id",
        "source_refs",
        "business_goals",
        "org_units",
        "processes",
        "baselines",
        "restrictions",
        "coverage_notes",
        "unknowns"
      ],
      "title": "CompanyContext"
    },
    "RiskRegister": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "reviewed_by_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "risks": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "risk_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "privacy",
                  "security",
                  "employment",
                  "ip",
                  "fairness",
                  "commercial",
                  "other"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "mitigated",
                  "accepted"
                ]
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "owner_role": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 3
              }
            },
            "required": [
              "risk_id",
              "category",
              "severity",
              "status",
              "mitigation",
              "owner_role",
              "evidence_ref"
            ]
          }
        }
      },
      "required": [
        "client_id",
        "reviewed_by_role",
        "reviewed_at",
        "risks"
      ],
      "title": "RiskRegister"
    },
    "ChallengeBrief": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "challenge_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "client_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "sponsor_role": {
          "type": "string",
          "minLength": 1
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 3
        },
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "unit",
              "target"
            ]
          }
        },
        "allowed_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "data_policy": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "rubric_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "accessibility_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "challenge_id",
        "client_id",
        "title",
        "problem_statement",
        "sponsor_role",
        "baseline_ref",
        "success_metrics",
        "data_policy",
        "difficulty",
        "rubric_id"
      ],
      "title": "ChallengeBrief"
    },
    "Rubric": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubric_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "weight",
              "measurement"
            ]
          }
        },
        "scoring_scale": {
          "type": "string",
          "enum": [
            "0-5"
          ]
        },
        "safety_veto": {
          "type": "boolean"
        },
        "published_before_start": {
          "type": "boolean"
        }
      },
      "required": [
        "rubric_id",
        "version",
        "criteria",
        "scoring_scale",
        "safety_veto",
        "published_before_start"
      ],
      "title": "Rubric"
    },
    "GateApproval": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "type": "string",
          "enum": [
            "G0",
            "G1",
            "G2"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_reference": {
          "type": "string",
          "minLength": 3
        },
        "decision_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "gate_id",
        "decision",
        "reviewer_role",
        "reviewer_reference",
        "decision_at",
        "evidence_refs",
        "conditions"
      ],
      "title": "GateApproval"
    }
  }
}
