{
  "title": "AuditBundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "audit_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "inventory_version": {
      "type": "string",
      "minLength": 1
    },
    "domain_count": {
      "type": "integer",
      "minimum": 0
    },
    "component_count": {
      "type": "integer",
      "minimum": 0
    },
    "gate_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "artifact_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "severity",
          "description"
        ]
      },
      "minItems": 0
    },
    "readiness": {
      "type": "string",
      "enum": [
        "design",
        "offline_tested",
        "production_verified"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "engagement_id",
    "audit_id",
    "inventory_version",
    "domain_count",
    "component_count",
    "gate_coverage",
    "artifact_coverage",
    "findings",
    "readiness",
    "limitations",
    "generated_at"
  ]
}
