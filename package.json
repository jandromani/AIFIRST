{
  "name": "aifirst",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Evidence-first enterprise AI discovery and agent evolution operating system (local pilot)",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --test",
    "check:catalog": "node bin/aifirst.mjs catalog",
    "check:synthetic": "node bin/aifirst.mjs gates examples/synthetic",
    "check:phase2": "node bin/phase2.mjs validate-demo examples/phase2",
    "inspect:phase2": "node bin/phase2.mjs inspect examples/phase2",
    "build:atlas": "node bin/build-atlas.mjs",
    "check:phase3": "node bin/phase3.mjs demo examples/phase3",
    "simulate:engagement": "node bin/engagement.mjs simulate",
    "export:engagement": "node bin/engagement.mjs simulate --write",
    "verify:local": "node bin/verify-local.mjs",
    "pilot:init": "node bin/api.mjs init",
    "pilot:serve": "node bin/api.mjs serve",
    "test:pilot": "node --test test/runtime.test.mjs",
    "test:enterprise": "node --test test/runtime.test.mjs test/enterprise.test.mjs",
    "pilot:report-export": "node bin/enterprise-pack.mjs export",
    "pilot:report-decrypt": "node bin/enterprise-pack.mjs decrypt",
    "backup:create": "node bin/backup.mjs create",
    "queue:once": "node bin/queue.mjs once",
    "test:hardening": "node --test test/runtime.test.mjs test/enterprise.test.mjs test/hardening.test.mjs test/job-queue.test.mjs test/openrouter-wiring.test.mjs test/output-contracts.test.mjs",
    "test:ux": "node --test test/ui-web.test.mjs",
    "test:ux:visual": "python tools/ux_smoke.py",
    "evolution:demo": "node bin/evolution.mjs demo",
    "test:evolution": "node --test test/evolution.test.mjs test/evolution-http.test.mjs test/evolution-adapters.test.mjs test/evolution-fabric.test.mjs test/evolution-fabric-http.test.mjs",
    "test:evolution:visual": "python tools/evolution_smoke.py",
    "evolution:integrated": "node bin/evolution-integration-demo.mjs --json",
    "test:evolution:extended": "node --test test/runtime.test.mjs test/enterprise.test.mjs test/hardening.test.mjs test/job-queue.test.mjs test/openrouter-wiring.test.mjs test/evolution.test.mjs test/evolution-http.test.mjs test/evolution-adapters.test.mjs test/evolution-fabric.test.mjs test/evolution-fabric-http.test.mjs",
    "lab:doctor": "node bin/local-stack.mjs doctor",
    "lab:jwks": "node bin/local-stack.mjs sync-jwks",
    "lab:pg:migrate": "node bin/stack-migrate.mjs migrate",
    "test:lab": "node --test test/local-stack.test.mjs test/local-stack-http.test.mjs",
    "test:lab:visual": "python tools/lab_ui_smoke.py",
    "lab:full": "node bin/lab-one-command.mjs full",
    "lab:verify": "node bin/lab-one-command.mjs verify",
    "lab:init": "node bin/lab-one-command.mjs init",
    "lab:stop": "node bin/lab-one-command.mjs stop",
    "lab:offline-proof": "node bin/lab-one-command.mjs offline-proof",
    "test:lab:integrated": "node --test test/lab-one-command.test.mjs test/lab-scenario.test.mjs test/lab-api.test.mjs",
    "preview:build": "node bin/build-public-preview.mjs",
    "test:public": "node --test test/public-preview.test.mjs",
    "test:theater": "node --test test/decision-theater.test.mjs",
    "test:theater:visual": "python tools/decision_theater_smoke.py"
  },
  "optionalDependencies": {
    "pg": "^8.16.0"
  }
}
