# Local, synthetic demo only. Never commit real keys or identities.
AIFIRST_SYNTHETIC_DEMO=1
AIFIRST_MASTER_KEY_B64= # generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AIFIRST_ENABLE_CLAMAV=0
AIFIRST_REQUIRE_OIDC=0
# OpenRouter free: enable only for synthetic metadata. Key never goes in browser.
AIFIRST_ALLOW_OPENROUTER_FREE=0
OPENROUTER_API_KEY=
AIFIRST_FREE_MODEL=openrouter/free
AIFIRST_FREE_DAILY_LIMIT=12
# Real enterprise OIDC: issuer and audience need to be configured by the customer's IdP admin.
AIFIRST_OIDC_ISSUER=
AIFIRST_OIDC_AUDIENCE=
AIFIRST_OIDC_JWKS_FILE=
# Finance/provider adapters: never assume connected by virtue of a URL.
AIFIRST_ERP_ENDPOINT=
AIFIRST_ERP_API_KEY=
AIFIRST_BANK_STATEMENT_VERIFY_KEY_PEM=
